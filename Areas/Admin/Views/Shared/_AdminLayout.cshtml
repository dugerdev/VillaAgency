<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Villa Agency Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --accent: #f59e0b;
            --accent-light: #fef3c7;
            --topbar-height: 60px;
        }
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f1f5f9; margin: 0; }

        /* Sidebar */
        .admin-sidebar {
            position: fixed; top: 0; left: 0; bottom: 0;
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            z-index: 1000;
            overflow-y: auto;
            transition: transform 0.3s;
        }
        .admin-sidebar .logo {
            display: flex; align-items: center; gap: 10px;
            padding: 20px 24px;
            border-bottom: 1px solid #1e293b;
            text-decoration: none;
        }
        .admin-sidebar .logo-icon {
            width: 36px; height: 36px; background: var(--accent);
            border-radius: 8px; display: flex; align-items: center; justify-content: center;
        }
        .admin-sidebar .logo-text { color: #fff; font-size: 16px; font-weight: 700; }
        .admin-sidebar .logo-sub { color: #94a3b8; font-size: 11px; }

        .sidebar-nav { padding: 16px 0; }
        .sidebar-section { padding: 8px 24px 4px; color: #475569; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
        .sidebar-nav a {
            display: flex; align-items: center; gap: 12px;
            padding: 10px 24px; color: #94a3b8; text-decoration: none;
            font-size: 14px; font-weight: 500; transition: all 0.2s;
            border-left: 3px solid transparent;
        }
        .sidebar-nav a:hover, .sidebar-nav a.active {
            background: var(--sidebar-hover); color: #fff;
            border-left-color: var(--accent);
        }
        .sidebar-nav a i { width: 18px; text-align: center; }
        .badge-count {
            margin-left: auto; background: #ef4444; color: #fff;
            font-size: 10px; padding: 2px 7px; border-radius: 20px; font-weight: 600;
        }

        /* Topbar */
        .admin-topbar {
            position: fixed; top: 0; left: var(--sidebar-width); right: 0;
            height: var(--topbar-height); background: #fff;
            border-bottom: 1px solid #e2e8f0; z-index: 999;
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 24px;
        }
        .admin-topbar .page-title { font-size: 16px; font-weight: 600; color: #0f172a; }
        .admin-topbar .topbar-right { display: flex; align-items: center; gap: 16px; }
        .topbar-user { display: flex; align-items: center; gap: 8px; }
        .topbar-user .avatar {
            width: 34px; height: 34px; background: var(--accent);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            color: #fff; font-weight: 700; font-size: 13px;
        }
        .topbar-user .name { font-size: 13px; font-weight: 600; color: #374151; }
        .btn-logout {
            background: none; border: 1px solid #e2e8f0; color: #64748b;
            padding: 6px 14px; border-radius: 6px; font-size: 13px;
            text-decoration: none; transition: all 0.2s;
        }
        .btn-logout:hover { background: #fee2e2; border-color: #fca5a5; color: #dc2626; }

        /* Main content */
        .admin-content {
            margin-left: var(--sidebar-width);
            margin-top: var(--topbar-height);
            padding: 28px;
            min-height: calc(100vh - var(--topbar-height));
        }

        /* Cards */
        .stat-card {
            background: #fff; border-radius: 12px; padding: 24px;
            border: 1px solid #e2e8f0; transition: box-shadow 0.2s;
        }
        .stat-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        .stat-card .icon {
            width: 48px; height: 48px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center; font-size: 20px;
        }
        .stat-card .value { font-size: 28px; font-weight: 700; color: #0f172a; }
        .stat-card .label { font-size: 13px; color: #64748b; }

        /* Admin table */
        .admin-table { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; }
        .admin-table table { margin: 0; }
        .admin-table thead th { background: #f8fafc; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; border-bottom: 1px solid #e2e8f0; }
        .admin-table .action-btns { display: flex; gap: 6px; }
        .btn-edit { background: #eff6ff; color: #2563eb; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; }
        .btn-edit:hover { background: #2563eb; color: #fff; }
        .btn-del { background: #fef2f2; color: #dc2626; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; }
        .btn-del:hover { background: #dc2626; color: #fff; }
        .btn-view { background: #f0fdf4; color: #16a34a; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; }
        .btn-view:hover { background: #16a34a; color: #fff; }

        /* Form card */
        .form-card { background: #fff; border-radius: 12px; padding: 28px; border: 1px solid #e2e8f0; }
        .form-card .form-label { font-weight: 500; font-size: 13px; color: #374151; }
        .form-card .form-control, .form-card .form-select { border-radius: 8px; border: 1px solid #d1d5db; font-size: 14px; }
        .form-card .form-control:focus, .form-card .form-select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }

        /* Page header */
        .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
        .page-header h2 { font-size: 22px; font-weight: 700; color: #0f172a; margin: 0; }
        .btn-primary-custom { background: var(--accent); color: #fff; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600; font-size: 14px; text-decoration: none; }
        .btn-primary-custom:hover { background: #d97706; color: #fff; }
        .btn-secondary-custom { background: #f1f5f9; color: #374151; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600; font-size: 14px; text-decoration: none; }
        .btn-secondary-custom:hover { background: #e2e8f0; color: #111; }

        /* Alert */
        .alert { border-radius: 10px; }

        /* Image preview */
        .img-preview { width: 80px; height: 60px; object-fit: cover; border-radius: 6px; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<!-- Sidebar -->
<aside class="admin-sidebar">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="logo">
        <div class="logo-icon"><i class="fa fa-home" style="color:#0f172a;font-size:16px;"></i></div>
        <div>
            <div class="logo-text">Villa Agency</div>
            <div class="logo-sub">Admin Panel</div>
        </div>
    </a>
    <nav class="sidebar-nav">
        <div class="sidebar-section">Main</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="fa fa-chart-pie"></i> Dashboard
        </a>

        <div class="sidebar-section">Content</div>
        <a asp-area="Admin" asp-controller="Property" asp-action="Index">
            <i class="fa fa-building"></i> Properties
        </a>
        <a asp-area="Admin" asp-controller="PropertyType" asp-action="Index">
            <i class="fa fa-tags"></i> Property Types
        </a>
        <a asp-area="Admin" asp-controller="Banner" asp-action="Index">
            <i class="fa fa-image"></i> Banners
        </a>
        <a asp-area="Admin" asp-controller="FAQ" asp-action="Index">
            <i class="fa fa-circle-question"></i> FAQs
        </a>

        <div class="sidebar-section">Communication</div>
        <a asp-area="Admin" asp-controller="ContactMessage" asp-action="Index">
            <i class="fa fa-envelope"></i> Messages
        </a>

        <div class="sidebar-section">Settings</div>
        <a asp-area="Admin" asp-controller="SiteSetting" asp-action="Index">
            <i class="fa fa-gear"></i> Site Settings
        </a>

        <div style="margin-top:24px; padding: 0 24px;">
            <a asp-area="" asp-controller="Home" asp-action="Index" style="display:flex;align-items:center;gap:10px;color:#64748b;font-size:13px;text-decoration:none;">
                <i class="fa fa-arrow-up-right-from-square"></i> View Site
            </a>
        </div>
    </nav>
</aside>

<!-- Topbar -->
<header class="admin-topbar">
    <span class="page-title">@(ViewBag.PageTitle ?? "Admin Panel")</span>
    <div class="topbar-right">
        <div class="topbar-user">
            <div class="avatar">A</div>
            <span class="name">Admin</span>
        </div>
        <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn-logout">
            <i class="fa fa-right-from-bracket"></i> Logout
        </a>
    </div>
</header>

<!-- Content -->
<main class="admin-content">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
