@model VillaAgency.Areas.Admin.Models.SiteSettingViewModel

<div class="page-header">
    <h2><i class="fa fa-gear me-2" style="color:#f59e0b;"></i>Site Settings</h2>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="form-card">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <h6 style="font-weight:700;margin-bottom:20px;color:#0f172a;padding-bottom:12px;border-bottom:1px solid #e2e8f0;">General</h6>
                <div class="mb-4">
                    <label class="form-label">Site Name</label>
                    <input asp-for="SiteName" class="form-control" placeholder="e.g. Villa Agency" />
                </div>

                <h6 style="font-weight:700;margin-bottom:20px;color:#0f172a;padding-bottom:12px;border-bottom:1px solid #e2e8f0;margin-top:28px;">Contact Information</h6>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="info@villa.co" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Physical Address</label>
                    <input asp-for="Address" class="form-control" placeholder="123 Main St, Miami, FL" />
                </div>

                <h6 style="font-weight:700;margin-bottom:20px;color:#0f172a;padding-bottom:12px;border-bottom:1px solid #e2e8f0;margin-top:28px;">Media & Map</h6>
                <div class="mb-3">
                    <label class="form-label">Google Maps Embed URL</label>
                    <input asp-for="MapEmbedUrl" class="form-control" placeholder="https://maps.google.com/maps?..." />
                    <div class="form-text">Paste the embed URL from Google Maps → Share → Embed a map.</div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Promo Video URL</label>
                    <input asp-for="VideoUrl" class="form-control" placeholder="https://youtube.com/..." />
                </div>

                <div class="d-flex gap-2 pt-3 border-top">
                    <button type="submit" class="btn-primary-custom px-5"><i class="fa fa-check me-2"></i>Save Settings</button>
                </div>
            </form>
        </div>
    </div>
</div>
