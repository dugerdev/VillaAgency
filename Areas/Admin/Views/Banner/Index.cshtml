@using VillaAgency.Models.Entities
@model List<Banner>

<div class="page-header">
    <h2><i class="fa fa-image me-2" style="color:#f59e0b;"></i>Banners</h2>
    <a asp-action="Create" class="btn-primary-custom"><i class="fa fa-plus me-2"></i>New Banner</a>
</div>

<div class="admin-table">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Category</th>
                <th>Order</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center py-5 text-muted">No banners yet.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="img-preview" alt="@item.Tittle" />
                        }
                        else
                        {
                            <div style="width:80px;height:60px;background:#f1f5f9;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                <i class="fa fa-image" style="color:#94a3b8;"></i>
                            </div>
                        }
                    </td>
                    <td style="font-weight:600;">@item.Tittle</td>
                    <td><span style="background:#f1f5f9;padding:3px 10px;border-radius:6px;font-size:12px;">@item.Category</span></td>
                    <td><span style="font-weight:600;color:#f59e0b;">@item.DisplayOrder</span></td>
                    <td>
                        <div class="action-btns">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">Edit</a>
                            <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Delete banner?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-del">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
