@model VillaAgency.Areas.Admin.Models.BannerEditViewModel

<div class="page-header">
    <h2><i class="fa fa-plus me-2" style="color:#f59e0b;"></i>New Banner</h2>
    <a asp-action="Index" class="btn-secondary-custom"><i class="fa fa-arrow-left me-2"></i>Back</a>
</div>
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-card">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-3"><label class="form-label">Title *</label><input asp-for="Title" class="form-control" placeholder="Banner headline" /></div>
                <div class="mb-3"><label class="form-label">Category</label><input asp-for="Category" class="form-control" placeholder="e.g. Premium, New Listing" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6"><label class="form-label">Display Order</label><input asp-for="DisplayOrder" class="form-control" type="number" /></div>
                    <div class="col-md-6"><label class="form-label">Link URL</label><input asp-for="LinkedinUrl" class="form-control" placeholder="https://..." /></div>
                </div>
                <div class="mb-4"><label class="form-label">Banner Image</label><input type="file" asp-for="ImageFile" class="form-control" accept="image/*" /></div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-custom flex-grow-1"><i class="fa fa-check me-2"></i>Create</button>
                    <a asp-action="Index" class="btn-secondary-custom">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
