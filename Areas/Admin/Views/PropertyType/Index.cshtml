@using VillaAgency.Models.Entities
@model List<PropertyType>

<div class="page-header">
    <h2><i class="fa fa-tags me-2" style="color:#f59e0b;"></i>Property Types</h2>
    <a asp-action="Create" class="btn-primary-custom"><i class="fa fa-plus me-2"></i>New Type</a>
</div>

<div class="admin-table">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center py-5 text-muted">No property types yet.</td></tr>
            }
            @{ int i = 1; }
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:#94a3b8;font-size:13px;">@(i++)</td>
                    <td style="font-weight:600;">@item.Name</td>
                    <td style="color:#64748b;font-size:13px;">@(item.Description.Length > 60 ? item.Description[..60] + "…" : item.Description)</td>
                    <td style="font-size:12px;color:#94a3b8;">@item.CreatedDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        <div class="action-btns">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">Edit</a>
                            <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Delete this type?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-del">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
