@using VillaAgency.Models.Entities
@model List<Contact>

<div class="page-header">
    <h2><i class="fa fa-envelope me-2" style="color:#f59e0b;"></i>Contact Messages
        @if (ViewBag.UnreadCount > 0)
        {
            <span class="badge" style="background:#ef4444;font-size:13px;margin-left:8px;border-radius:20px;padding:4px 12px;">@ViewBag.UnreadCount unread</span>
        }
    </h2>
</div>

<div class="admin-table">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Status</th>
                <th>Name</th>
                <th>Email</th>
                <th>Subject</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-5 text-muted">No messages yet.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr style="@(!item.IsRead ? "background:#fffbeb;" : "")">
                    <td>
                        @if (!item.IsRead)
                        {
                            <span style="display:inline-block;width:10px;height:10px;background:#f59e0b;border-radius:50%;"></span>
                        }
                        else
                        {
                            <span style="display:inline-block;width:10px;height:10px;background:#e2e8f0;border-radius:50%;"></span>
                        }
                    </td>
                    <td style="font-weight:@(!item.IsRead ? "700" : "400");">@item.FullName</td>
                    <td style="font-size:13px;color:#64748b;">@item.Email</td>
                    <td style="font-size:13px;">@item.Subject</td>
                    <td style="font-size:12px;color:#94a3b8;">@item.CreatedDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        <div class="action-btns">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn-view">View</a>
                            <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Delete message?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-del">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
