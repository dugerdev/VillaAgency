@{
    ViewBag.PageTitle = "Dashboard";
}

<div class="page-header">
    <h2><i class="fa fa-chart-pie me-2" style="color:#f59e0b;"></i>Dashboard</h2>
    <span style="color:#64748b;font-size:13px;">Welcome back, Admin</span>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="icon" style="background:#fff7ed;"><i class="fa fa-building" style="color:#f59e0b;"></i></div>
                <span style="font-size:11px;color:#64748b;font-weight:600;">TOTAL</span>
            </div>
            <div class="value">@ViewBag.TotalProperties</div>
            <div class="label">Properties</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="icon" style="background:#eff6ff;"><i class="fa fa-star" style="color:#2563eb;"></i></div>
                <span style="font-size:11px;color:#64748b;font-weight:600;">FEATURED</span>
            </div>
            <div class="value">@ViewBag.FeaturedProperties</div>
            <div class="label">Featured Properties</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="icon" style="background:#f0fdf4;"><i class="fa fa-envelope" style="color:#16a34a;"></i></div>
                <span style="background:#ef4444;color:#fff;font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600;">@ViewBag.UnreadMessages NEW</span>
            </div>
            <div class="value">@ViewBag.TotalMessages</div>
            <div class="label">Contact Messages</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="icon" style="background:#fdf4ff;"><i class="fa fa-circle-question" style="color:#9333ea;"></i></div>
                <span style="font-size:11px;color:#64748b;font-weight:600;">TOTAL</span>
            </div>
            <div class="value">@ViewBag.TotalFAQs</div>
            <div class="label">FAQs</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="stat-card h-100">
            <h6 style="font-weight:700;color:#0f172a;margin-bottom:20px;"><i class="fa fa-tags me-2" style="color:#f59e0b;"></i>Quick Stats</h6>
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                <span style="font-size:14px;color:#374151;">Property Types</span>
                <span class="badge" style="background:#f59e0b;color:#fff;font-size:13px;padding:5px 12px;border-radius:8px;">@ViewBag.TotalPropertyTypes</span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                <span style="font-size:14px;color:#374151;">Active Banners</span>
                <span class="badge" style="background:#f59e0b;color:#fff;font-size:13px;padding:5px 12px;border-radius:8px;">@ViewBag.TotalBanners</span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-3">
                <span style="font-size:14px;color:#374151;">Unread Messages</span>
                <span class="badge" style="background:#ef4444;color:#fff;font-size:13px;padding:5px 12px;border-radius:8px;">@ViewBag.UnreadMessages</span>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card h-100">
            <h6 style="font-weight:700;color:#0f172a;margin-bottom:20px;"><i class="fa fa-bolt me-2" style="color:#f59e0b;"></i>Quick Actions</h6>
            <div class="d-grid gap-2">
                <a asp-area="Admin" asp-controller="Property" asp-action="Create" class="btn-primary-custom text-center py-2">
                    <i class="fa fa-plus me-2"></i>Add New Property
                </a>
                <a asp-area="Admin" asp-controller="Banner" asp-action="Create" class="btn-secondary-custom text-center py-2">
                    <i class="fa fa-image me-2"></i>Add New Banner
                </a>
                <a asp-area="Admin" asp-controller="ContactMessage" asp-action="Index" class="btn-secondary-custom text-center py-2">
                    <i class="fa fa-envelope me-2"></i>View Messages
                </a>
                <a asp-area="Admin" asp-controller="SiteSetting" asp-action="Index" class="btn-secondary-custom text-center py-2">
                    <i class="fa fa-gear me-2"></i>Site Settings
                </a>
            </div>
        </div>
    </div>
</div>
