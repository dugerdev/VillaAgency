@using VillaAgency.Models.ViewModels
@model FeaturedViewModel

<div class="featured section">
    <div class="container">
        <div class="row">

            <!-- SOL TARAFA RESÝM VE BAÞLIK -->
            <div class="col-lg-4">
                <div class="left-image">
                    @{
                        var mainImage = Model.FeaturedProperty?.PropertyImages?.FirstOrDefault(x => x.IsMain)?.ImageUrl
                        ?? "/assets/images/featured.jpg";
                    }
                    <img src="@mainImage" alt="">

                    <!-- ÝKON (SÜS AMAÇLI) -->
                    <a href="property-details.html">
                        <img src="~/assets/images/featured-icon.png" alt="" style="max-width: 60px; padding: 0px;">
                    </a>
                </div>
            </div>

            <!-- ORTA KISIM: BAÞLIK VE SORULAR (ACCORDION) -->
            <div class="col-lg-5">
                <div class="section-heading">
                    <h6>| Featured</h6>
                    <h2>@Model.FeaturedProperty?.Tittle</h2> <!-- Mülk Baþlýðý -->
                </div>

                <div class="accordion" id="accordionExample">
                    @foreach (var faq in Model.FAQs)
                    {
                        var index = Model.FAQs.IndexOf(faq); // Sayaç (0, 1, 2...)
                        var isFirst = index == 0 ? "show" : ""; // Ýlk eleman açýk gelsin
                        var isCollapsed = index == 0 ? "" : "collapsed"; // Diðerleri kapalý

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-@faq.Id">
                                <button class="accordion-button @isCollapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@faq.Id" aria-expanded="@(index == 0)" aria-controls="collapse-@faq.Id">
                                    @faq.Question
                                </button>
                            </h2>
                            <div id="collapse-@faq.Id" class="accordion-collapse collapse @isFirst" aria-labelledby="heading-@faq.Id" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    @Html.Raw(faq.Answer)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- SAÐ TARAFA MÜLK DETAYLARI (TABLO) -->
            <div class="col-lg-3">
                <div class="info-table">
                    <ul>
                        <li>
                            <img src="~/assets/images/info-icon-01.png" alt="" style="max-width: 52px;">
                            <h4>@Model.FeaturedProperty?.TotalFlatSpace m2<br><span>Total Flat Space</span></h4>
                        </li>
                        <li>
                            <img src="~/assets/images/info-icon-02.png" alt="" style="max-width: 52px;">
                            <h4>@((Model.FeaturedProperty?.IsContractReady == true) ? "Yes" : "No")<br><span>Contract Ready</span></h4>
                        </li>
                        <li>
                            <img src="~/assets/images/info-icon-03.png" alt="" style="max-width: 52px;">
                            <h4>@Model.FeaturedProperty?.PaymentProcess<br><span>Payment Process</span></h4>
                        </li>
                        <li>
                            <img src="~/assets/images/info-icon-04.png" alt="" style="max-width: 52px;">
                            <h4>Safety<br><span>24/7 Under Control</span></h4>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>