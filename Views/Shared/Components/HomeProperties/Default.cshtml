@using VillaAgency.Models.Entities
@model List<Property> // Controller'dan gelen listeyi Model olarak alýyoruz.

<!-- BÖLÜM BAÞLANGICI: PROPERTIES -->
<div class="properties section">
    <div class="container">

        <!-- BAÞLIK KISMI -->
        <div class="row">
            <div class="col-lg-4 offset-lg-4">
                <div class="section-heading text-center">
                    <h6>| Properties</h6>
                    <h2>We Provide The Best Property You Like</h2>
                </div>
            </div>
        </div>

        <!-- MÜLK KARTLARI (Properties Cards) -->
        <div class="row">
            @foreach (var item in Model)
            {
                // Mülkün ana resmini bulalým (Yoksa varsayýlan bir resim kullanýrýz)
                var mainImage = item.PropertyImages?.FirstOrDefault(x => x.IsMain)?.ImageUrl ?? "/assets/images/property-01.jpg";

                <div class="col-lg-4 col-md-6">
                    <div class="item">
                        <!-- Mülk Resmi -->
                        <a asp-controller="PropertyDetails" asp-action="Index" asp-route-id="@item.Id">
                            <img src="@mainImage" alt="@item.Tittle">
                        </a>

                        <!-- Mülk Tipi (Kategori) ve Fiyat -->
                        <span class="category">@item.PropertyType?.Name</span>
                        <h6>$@item.Price.ToString("N0")</h6> <!-- N0: Binlik ayraçlý (örn: 1,500) -->
                        <!-- Mülk Baþlýðý -->
                        <h4>
                            <a asp-controller="PropertyDetails" asp-action="Index" asp-route-id="@item.Id">
                                @item.Tittle
                            </a>
                        </h4>

                        <!-- Özellikler (Yatak Odasý, Banyo, m2 vb.) -->
                        <ul>
                            <li>Bedrooms: <span>@item.BedRooms</span></li>
                            <li>Bathrooms: <span>@item.Bathrooms</span></li>
                            <li>Area: <span>@item.TotalFlatSpace m2</span></li>
                            <li>Floor: <span>@item.Floor</span></li>
                            <li>Parking: <span>@item.Parking</span></li>
                        </ul>

                        <!-- Buton: Detay Sayfasýna Git -->
                        <div class="main-button">
                            <a asp-controller="PropertyDetails" asp-action="Index" asp-route-id="@item.Id">Schedule a visit</a>
                        </div>
                    </div>
                </div>
            }
        </div> <!-- End Row -->

    </div>
</div>