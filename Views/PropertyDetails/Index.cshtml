@model VillaAgency.Models.Entities.Property

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <span class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> / Single Property</span>
                <h3>@Model.Tittle</h3>
            </div>
        </div>
    </div>
</div>

<div class="single-property section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="main-image">
                    @{
                        var mainImage = Model.PropertyImages?.FirstOrDefault(x => x.IsMain)?.ImageUrl ?? "/assets/images/single-property.jpg";
                    }
                    <img src="@mainImage" alt="@Model.Tittle">
                </div>
                <div class="main-content">
                    <span class="category">@Model.PropertyType?.Name</span>
                    <h4>@Model.Tittle</h4>
                    <p>@Html.Raw(Model.Description)</p>
                    
                    @if (!string.IsNullOrEmpty(Model.VideoUrl))
                    {
                        <br><br>
                        <p>Video Link: <a href="@Model.VideoUrl" target="_blank">Watch Video</a></p>
                    }
                </div> 
                <div class="accordion" id="accordionExample">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                Best useful links ?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                Get <strong>the best villa</strong> website template in HTML CSS and Bootstrap for your business. TemplateMo provides you the <a href="https://www.google.com/search?q=best+free+css+templates" target="_blank">best free CSS templates</a> in the world. Please tell your friends about it.
                            </div>
                        </div>
                    </div>
                    <!-- Diğer accordion item'lar -->
                </div>
            </div>
            <div class="col-lg-4">
                <div class="info-table">
                    <ul>
                        <li>
                            <img src="~/assets/images/info-icon-01.png" alt="" style="max-width: 52px;">
                            <h4>@Model.TotalFlatSpace m2<br><span>Total Flat Space</span></h4>
                        </li>
                        <li>
                            <img src="~/assets/images/info-icon-02.png" alt="" style="max-width: 52px;">
                            <h4>@((Model.IsContractReady) ? "Yes" : "No")<br><span>Contract Ready</span></h4>
                        </li>
                        <li>
                            <img src="~/assets/images/info-icon-03.png" alt="" style="max-width: 52px;">
                            <h4>@Model.PaymentProcess<br><span>Payment Process</span></h4>
                        </li>
                        <li>
                            <img src="~/assets/images/info-icon-04.png" alt="" style="max-width: 52px;">
                            <h4>Safety<br><span>24/7 Under Control</span></h4>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
