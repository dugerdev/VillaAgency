@model VillaAgency.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Villa Agency - Admin Login</title>
    <!-- CSS Linkleri -->
    <link href="~/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/fontawesome.css">
    <link rel="stylesheet" href="~/assets/css/templatemo-villa-agency.css">

    <style>
        body {
            background-image: url('/assets/images/banner-01.jpg');
            background-size: cover;
            background-position: center;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Poppins', sans-serif;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 400px;
            text-align: center;
        }

        .form-control {
            border-radius: 30px;
            padding: 12px 20px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
        }

        .btn-login {
            background-color: #f35525;
            color: #fff;
            border-radius: 30px;
            padding: 12px;
            width: 100%;
            border: none;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-login:hover {
                background-color: #1e1e1e;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <h3>Admin Login</h3>
        <hr />
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Email" class="form-control" placeholder="Email Address" required />
            <input asp-for="Password" class="form-control" type="password" placeholder="Password" required />

            <div class="form-check text-start mb-3 ms-2">
                <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="remMe">
                <label class="form-check-label" for="remMe">Remember Me</label>
            </div>

            <button type="submit" class="btn-login">Sign In</button>
        </form>
        <div class="mt-3">
            <a href="/" style="text-decoration: none; color: #666;">Back to Home</a>
        </div>
    </div>

</body>
</html>