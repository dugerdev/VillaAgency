@model List<VillaAgency.Models.Entities.Property>

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <span class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> / Properties</span>
                <h3>Properties</h3>
            </div>
        </div>
    </div>
</div>

<div class="section properties">
    <div class="container">
        <!-- Kategori Filtreleme Alanı -->
        <ul class="properties-filter">
            <li>
                <a class="@(ViewBag.SelectedCategory == null ? "is_active" : "")" asp-action="Index" asp-route-categoryId="">Show All</a>
            </li>
            @foreach (var category in (List<VillaAgency.Models.Entities.PropertyType>)ViewBag.Categories)
            {
                <li>
                    <a class="@(ViewBag.SelectedCategory == category.Id ? "is_active" : "")" 
                       asp-action="Index" 
                       asp-route-categoryId="@category.Id">@category.Name</a>
                </li>
            }
        </ul>

        <!-- Mülk Listesi -->
        <div class="row properties-box">
            @foreach (var item in Model)
            {
                var mainImage = item.PropertyImages.FirstOrDefault(x => x.IsMain)?.ImageUrl ?? "/assets/images/property-01.jpg";
                
                <div class="col-lg-4 col-md-6 align-self-center mb-30 properties-items col-md-6 @item.PropertyType?.Name.ToLower().Replace(" ","")">
                    <div class="item">
                        <a asp-controller="PropertyDetails" asp-action="Index" asp-route-id="@item.Id"><img src="@mainImage" alt=""></a>
                        <span class="category">@item.PropertyType?.Name</span>
                        <h6>$@item.Price.ToString("N0")</h6>
                        <h4><a asp-controller="PropertyDetails" asp-action="Index" asp-route-id="@item.Id">@item.Tittle</a></h4>
                        <ul>
                            <li>Bedrooms: <span>@item.BedRooms</span></li>
                            <li>Bathrooms: <span>@item.Bathrooms</span></li>
                            <li>Area: <span>@item.Area m2</span></li>
                            <li>Floor: <span>@item.Floor</span></li>
                            <li>Parking: <span>@item.Parking</span></li>
                        </ul>
                        <div class="main-button">
                            <a asp-controller="PropertyDetails" asp-action="Index" asp-route-id="@item.Id">Schedule a visit</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sayfalama (Pagination) -->
        <div class="row">
            <div class="col-lg-12">
                <ul class="pagination">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li><a class="@(i == ViewBag.CurrentPage ? "is_active" : "")" asp-action="Index" asp-route-page="@i" asp-route-categoryId="@ViewBag.SelectedCategory">@i</a></li>
                    }
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                         <li><a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-categoryId="@ViewBag.SelectedCategory">&gt;</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>